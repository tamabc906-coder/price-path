# Chép thành .env (không commit). Sinh cặp khoá VAPID: venv\Scripts\python -m job.gen_vapid (G3)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Tuỳ chọn: Cloudflare Worker giữ đăng ký push; để trống thì dùng PUSH_SUBS_FALLBACK (JSON mảng subscription)
WORKER_URL=
WORKER_TOKEN=
PUSH_SUBS_FALLBACK=
